---
import '../styles/global.css';

const description =
  'Gabriel Oyarzo, ingeniero de datos. Diseño y opero data warehouses: ingesta, modelado dimensional con dbt y métricas para Power BI, reportes e IA.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1f3ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121a19" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>Gabriel Oyarzo, ingeniero de datos</title>
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 btn btn-primary"
      >Ir al contenido</a
    >
    <slot />
  </body>
</html>
