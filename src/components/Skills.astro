---
import { getCollection } from 'astro:content';

const skillGroups = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
---

<dl class="border-b border-line">
  {
    skillGroups.map(({ data }) => (
      <div class="row !py-5">
        <dt class="font-medium">{data.category}</dt>
        <dd class="m-0 text-muted">{data.items.join(', ')}</dd>
      </div>
    ))
  }
</dl>
