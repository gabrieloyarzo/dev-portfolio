---
import { getCollection } from 'astro:content';

const experiences = (await getCollection('experiences')).sort(
  (a, b) => b.data.order - a.data.order,
);
---

<ol class="border-b border-line">
  {
    experiences.map(({ data }) => (
      <li class="row">
        <div class="row-aside">
          <time>{data.date}</time>
          <p>{data.location}</p>
        </div>
        <div>
          <h3 class="font-display text-xl font-semibold tracking-tight sm:text-2xl">
            {data.title}
          </h3>
          <p class="text-muted">
            {data.company}
            {data.subtitle && `, ${data.subtitle.toLowerCase()}`}
          </p>
          {(() => {
            const [lead, ...rest] = data.description.split(/(?<=\.)\s+(?=[A-ZÁÉÍÓÚ])/);
            return (
              <>
                <p class="mt-4 max-w-[68ch] text-pretty">{lead}</p>
                {rest.length > 0 && (
                  <ul class="mt-3 flex max-w-[68ch] flex-col gap-2 text-pretty">
                    {rest.map((s) => (
                      <li class="relative pl-5 before:absolute before:top-[0.7em] before:left-0 before:h-1.5 before:w-1.5 before:rounded-full before:bg-cobalt">
                        {s}
                      </li>
                    ))}
                  </ul>
                )}
              </>
            );
          })()}
          {data.technologies && (
            <ul class="mt-5 flex max-w-[68ch] flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
              {data.technologies.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>
