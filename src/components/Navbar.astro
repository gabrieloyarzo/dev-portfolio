---
interface Section {
  label: string;
  id: string;
}

type Sections = 'HOME' | 'EXPERIENCE' | 'PROJECTS' | 'SKILLS' | 'EDUCATION' | 'CONTACT';

export const SECTION: Record<Sections, Section> = {
  HOME: { label: 'Inicio', id: 'inicio' },
  EXPERIENCE: { label: 'Experiencia', id: 'experiencia' },
  PROJECTS: { label: 'Proyectos', id: 'proyectos' },
  SKILLS: { label: 'Conocimientos', id: 'conocimientos' },
  EDUCATION: { label: 'Educación', id: 'educacion' },
  CONTACT: { label: 'Contacto', id: 'contacto' },
};

const LINKS = [SECTION.EXPERIENCE, SECTION.PROJECTS, SECTION.SKILLS, SECTION.CONTACT];
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/85 backdrop-blur-md">
  <nav class="wrap flex h-16 items-center justify-between gap-4" aria-label="Principal">
    <a href={`#${SECTION.HOME.id}`} class="font-display text-lg font-semibold tracking-tight">
      Gabriel Oyarzo
    </a>
    <ul class="hidden items-center gap-7 text-sm text-muted md:flex">
      {
        LINKS.map((s) => (
          <li>
            <a href={`#${s.id}`} class="transition-colors hover:text-ink">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/Gabriel_Oyarzo_CV.pdf" download class="btn btn-quiet !py-1.5">
      <i class="fa-solid fa-arrow-down text-xs" aria-hidden="true"></i>
      CV en PDF
    </a>
  </nav>
</header>
