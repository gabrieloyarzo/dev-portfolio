---
import { SOCIALS_URL } from '../assets/socials';
const email = SOCIALS_URL.mail.replace('mailto:', '');
---

<div class="rounded-2xl bg-ink px-6 py-12 text-paper sm:px-12 sm:py-16">
  <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-5xl">
    Contacto
  </h2>
  <p class="mt-4 max-w-[52ch] text-paper/75">
    Disponible para proyectos y oportunidades en ingeniería de datos, modelado y analítica.
  </p>
  <a
    href={SOCIALS_URL.mail}
    class="mt-8 inline-block font-display text-xl font-medium break-all underline decoration-paper/40 decoration-2 underline-offset-[6px] transition-colors hover:decoration-signal sm:text-3xl"
  >
    {email}
  </a>
  <div class="mt-8 flex flex-wrap gap-6 text-paper/80">
    <a
      href={SOCIALS_URL.linkedIn}
      target="_blank"
      rel="noopener noreferrer"
      class="hover:text-paper"
    >
      <i class="fa-brands fa-linkedin-in mr-2" aria-hidden="true"></i>LinkedIn
    </a>
    <a href={SOCIALS_URL.github} target="_blank" rel="noopener noreferrer" class="hover:text-paper">
      <i class="fa-brands fa-github mr-2" aria-hidden="true"></i>GitHub
    </a>
    <a href="/Gabriel_Oyarzo_CV.pdf" download class="hover:text-paper">
      <i class="fa-solid fa-arrow-down mr-2" aria-hidden="true"></i>CV en PDF
    </a>
  </div>
</div>
