---
import { getCollection } from 'astro:content';

const education = (await getCollection('education')).sort((a, b) => b.data.order - a.data.order);
const languages = (await getCollection('languages')).sort((a, b) => a.data.order - b.data.order);
---

<ul class="border-b border-line">
  {
    education.map(({ data }) =>
      data.degrees.map((deg) => (
        <li class="row !py-5">
          <p class="row-aside">{deg.period}</p>
          <div>
            <h3 class="font-medium">{deg.title}</h3>
            <p class="text-muted">
              {data.institution}, {data.location}
            </p>
          </div>
        </li>
      )),
    )
  }
  <li class="row !py-5">
    <p class="row-aside">Idiomas</p>
    <p>
      {
        languages
          .map(({ data }) => {
            const certs = data.certifications?.map((c) => c.label).join(' y ');
            return `${data.name} ${data.level.toLowerCase()}${certs ? ` (${certs})` : ''}`;
          })
          .join(', ')
      }
    </p>
  </li>
</ul>
