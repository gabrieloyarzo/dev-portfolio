---
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => b.data.order - a.data.order);
---

<p class="mb-8 max-w-[60ch] text-muted">
  Sistemas de gestión que desarrollé antes de dedicarme a los datos.
</p>
<ul class="grid gap-x-10 gap-y-12 md:grid-cols-3">
  {
    projects.map(({ data }) => (
      <li>
        <img
          src={data.imageUrl}
          alt={`Pantalla de ${data.title}`}
          loading="lazy"
          class="aspect-[16/10] w-full rounded-lg border border-line object-cover object-top"
        />
        <h3 class="mt-4 font-display text-lg font-semibold tracking-tight">{data.title}</h3>
        <p class="text-sm text-muted">
          {data.role}, {data.technologies.join(', ')}
        </p>
        <p class="mt-2 text-[0.95rem] text-pretty">{data.description}</p>
      </li>
    ))
  }
</ul>
