---
import Experiences from '../components/Experiences.astro';
import Education from '../components/Education.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
import Lineage from '../components/Lineage.astro';
import SectionContainer from '../components/SectionContainer.astro';
import { SECTION } from '../components/Navbar.astro';
import { SOCIALS_URL } from '../assets/socials';
---

<Layout>
  <main id="contenido">
    <section id={SECTION.HOME.id} class="wrap pt-16 pb-20 sm:pt-24">
      <p class="text-muted">Ingeniero de Datos, Osorno, Chile</p>
      <h1
        class="mt-3 font-display text-[clamp(2.75rem,8vw,5.5rem)] leading-[0.95] font-semibold tracking-[-0.03em] text-balance"
      >
        Gabriel Oyarzo Ramírez
      </h1>
      <p class="mt-8 max-w-[38rem] text-lg text-pretty text-muted sm:text-xl">
        Diseño y opero plataformas de datos para la toma de decisiones: integración del ERP y los
        sistemas clínicos, modelado dimensional con dbt y una capa de métricas común para Power BI,
        reportes automatizados e inteligencia artificial.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`#${SECTION.CONTACT.id}`} class="btn btn-primary">Contacto</a>
        <a
          href={SOCIALS_URL.linkedIn}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-quiet"
        >
          <i class="fa-brands fa-linkedin-in" aria-hidden="true"></i> LinkedIn
        </a>
        <a
          href={SOCIALS_URL.github}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-quiet"
        >
          <i class="fa-brands fa-github" aria-hidden="true"></i> GitHub
        </a>
      </div>

      <div class="mt-16 sm:mt-20">
        <Lineage />
      </div>
    </section>

    <SectionContainer id={SECTION.EXPERIENCE.id} title="Experiencia">
      <Experiences />
    </SectionContainer>

    <SectionContainer id={SECTION.PROJECTS.id} title="Proyectos anteriores">
      <Projects />
    </SectionContainer>

    <SectionContainer id={SECTION.SKILLS.id} title="Conocimientos">
      <Skills />
    </SectionContainer>

    <SectionContainer id={SECTION.EDUCATION.id} title="Educación">
      <Education />
    </SectionContainer>

    <SectionContainer id={SECTION.CONTACT.id}>
      <Contact />
    </SectionContainer>
  </main>
</Layout>
